{
  "name": "caniogan-request",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,database --project demo-caniogan-request",
    "test:rules": "firebase emulators:exec --only database --project demo-caniogan-request \"node --test --test-concurrency=1 tests/database.rules.test.mjs tests/request-rules.test.mjs\"",
    "test:rules:running": "node --test --test-concurrency=1 tests/database.rules.test.mjs tests/request-rules.test.mjs",
    "test:e2e": "playwright test",
    "test:copy": "node --test tests/locales.test.mjs",
    "test:e2e:isolated": "firebase emulators:exec --only auth,database --project demo-caniogan-request \"playwright test\""
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "firebase": "^13.0.0",
    "i18next": "26.5.2",
    "leaflet": "1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.1.0",
    "react-leaflet": "5.0.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-tools": "15.34.0",
    "globals": "^17.12.0",
    "vite": "^8.3.0",
    "wrangler": "4.151.1"
  }
}
