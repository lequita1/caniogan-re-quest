# Copy to .env.local and use the Firebase Web app settings for this project.
# These VITE_ values are public browser configuration, not server secrets.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=caniogan-request.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=caniogan-request
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_DATABASE_URL=https://caniogan-request-default-rtdb.asia-southeast1.firebasedatabase.app

# Local development only. Leave false for your real Firebase project.
VITE_USE_FIREBASE_EMULATORS=false

# Public Cloudinary settings. Signed uploads also require a trusted backend.
# Never put a Cloudinary API secret in a VITE_ variable.
VITE_CLOUDINARY_CLOUD_NAME=b2n0ms1f
VITE_CLOUDINARY_UPLOAD_PRESET=caniogan_request_images

# Trusted media backend; do not enter an API secret here.
VITE_MEDIA_API_URL=https://caniogan-request-media.quitalouie3.workers.dev

# Optional local Auth emulator override. Used only with emulator mode enabled.
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
