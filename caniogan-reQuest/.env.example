# Copy to .env.local and use the Firebase Web app settings for this project.
# These VITE_ values are public browser configuration, not server secrets.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=caniogan-request.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=caniogan-request
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_FIREBASE_DATABASE_URL=https://caniogan-request-default-rtdb.asia-southeast1.firebasedatabase.app

# Local development only. Leave false for your real Firebase project.
VITE_USE_FIREBASE_EMULATORS=false
